# ==============================================================================
# AI Viva & Interview Preparation Coach - Environment Variables Template
# ==============================================================================

# AI Configuration (Anthropic Claude)
# Provide your Anthropic API Key (e.g. sk-ant-api03-...) or use "mock" for offline testing
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AI Configuration (Google Gemini)
# Provide your Google Gemini API Key (e.g. AIzaSy...) or use "mock" for offline testing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Designated AI Providers (claude / gemini)
EVALUATION_PROVIDER=claude
MODEL_ANSWER_PROVIDER=gemini

# Security & Authentication
# In production, generate a strong random 256-bit string
JWT_SECRET_KEY=dev-secret-key-change-in-production-viva-coach
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 Authentication
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Configure an OAuth 2.0 Web Client ID with authorized JavaScript origins (e.g. http://localhost:5173)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./viva_coach.db

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
