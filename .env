# ==============================================================================
# AI Viva & Interview Preparation Coach - Environment Variables
# ==============================================================================

# Set to your real Anthropic Claude API key: sk-ant-api03-...
# Or keep as "mock" for offline local developer simulation without an API key
ANTHROPIC_API_KEY=mock
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Set to your real OpenAI API key: sk-...
# Or keep as "mock" for offline local developer simulation without an API key
OPENAI_API_KEY=mock
OPENAI_MODEL=gpt-4o-mini

# Google Gemini fallback
GEMINI_API_KEY=mock
GEMINI_MODEL=gemini-1.5-flash

# Designated AI Providers (claude / openai)
EVALUATION_PROVIDER=claude
MODEL_ANSWER_PROVIDER=openai

# Security & Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-viva-coach
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Google OAuth 2.0 (Configure with your real Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./viva_coach.db

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
